# ─────────────────────────────────────────────────────────────────
#  PDF Suite Local — Variables de entorno
#  Copia este archivo: cp .env.example .env
#  Nunca commitees .env
# ─────────────────────────────────────────────────────────────────

# ── Base de datos ──────────────────────────────────────────────────
POSTGRES_DB=pdfsuite
POSTGRES_USER=pdfuser
# ¡Cambia esta contraseña antes de usar!
POSTGRES_PASSWORD=cambia_esta_contraseña_ahora

# ── Seguridad ──────────────────────────────────────────────────────
# Genera con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia_esta_clave_secreta_ahora_con_32_bytes_hexadecimales

# ── Límites de archivos ─────────────────────────────────────────────
MAX_FILE_SIZE_MB=100

# ── Expiración por defecto de documentos ──────────────────────────
DEFAULT_EXPIRY_DAYS=30

# ── URLs (no cambiar para desarrollo local) ────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
