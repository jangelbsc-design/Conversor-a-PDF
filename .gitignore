# ─── Credenciales (NUNCA commitear) ───────────────────────────────
.env
*.key
*.pem
*.p12

# ─── Datos de usuario (almacenamiento local) ───────────────────────
store/originals/*
store/outputs/*
store/previews/*
store/audit.jsonl
*.db
*.sqlite3
!store/originals/.gitkeep
!store/outputs/.gitkeep
!store/previews/.gitkeep

# ─── Python ───────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyc
.venv/
venv/
dist/
build/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ─── Node / Next.js ───────────────────────────────────────────────
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo

# ─── PostgreSQL data ───────────────────────────────────────────────
pgdata/

# ─── Sistema operativo ────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── IDEs ─────────────────────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo
